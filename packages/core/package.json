{
	"name": "@codemem/core",
	"version": "0.49.0-beta.6",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./feed-contract": {
			"source": "./src/feed-contract.ts",
			"import": "./dist/feed-contract.js",
			"types": "./dist/feed-contract.d.ts"
		},
		"./recipient-policy-contract": {
			"source": "./src/recipient-policy-contract.ts",
			"import": "./dist/recipient-policy-contract.js",
			"types": "./dist/recipient-policy-contract.d.ts"
		},
		"./internal/relay-runtime": {
			"source": "./src/internal/relay-runtime.ts",
			"import": "./dist/internal/relay-runtime.js",
			"types": "./dist/internal/relay-runtime.d.ts"
		},
		"./internal/relay-host": {
			"source": "./src/internal/relay-host.ts",
			"import": "./dist/internal/relay-host.js",
			"types": "./dist/internal/relay-host.d.ts"
		},
		"./internal/cloudflare-coordinator": {
			"source": "./src/internal/cloudflare-coordinator.ts",
			"import": "./dist/internal/cloudflare-coordinator.js",
			"types": "./dist/internal/cloudflare-coordinator.d.ts"
		}
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "pnpm exec vite build && rm -f tsconfig.tsbuildinfo && pnpm exec tsc --build && test -f dist/index.d.ts && test -f dist/feed-contract.d.ts && test -f dist/recipient-policy-contract.d.ts && test -f dist/internal/cloudflare-coordinator.d.ts && test -f dist/semantic-worker-entry.js",
		"typecheck": "pnpm exec tsc --noEmit",
		"generate:test-schema": "pnpm exec tsx scripts/generate-test-schema.ts"
	},
	"devDependencies": {
		"@codemem/embeddings": "workspace:^",
		"@types/better-sqlite3": "catalog:",
		"@types/ws": "8.18.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@libp2p/crypto": "5.2.0",
		"@libp2p/interface": "3.4.0",
		"@libp2p/noise": "17.0.7",
		"@libp2p/peer-id": "6.0.18",
		"@libp2p/utils": "7.4.5",
		"@opencode/client": "2.0.24",
		"better-sqlite3": "13.0.3",
		"bonjour-service": "^1.4.4",
		"drizzle-orm": "catalog:",
		"eventsource-parser": "4.1.0",
		"hono": "catalog:",
		"limiter": "catalog:",
		"openid-client": "6.8.8",
		"sqlite-vec": "0.1.9",
		"ws": "8.21.3",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@codemem/embeddings": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@codemem/embeddings": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunickiaj/codemem.git",
		"directory": "packages/core"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
