{
	"name": "@codemem/ui",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rm -rf ../viewer-server/static",
		"dev": "node ./scripts/make-dev-html.mjs && vite",
		"gallery:dev": "node ./scripts/make-gallery-html.mjs && vite --config vite.gallery.config.ts",
		"gallery:build": "node ./scripts/make-gallery-html.mjs && vite build --config vite.gallery.config.ts",
		"build": "vite build --mode production && node ./scripts/stage-viewer-static.mjs --precompress",
		"build:watch": "node ./scripts/stage-viewer-static.mjs && vite build --watch --mode development",
		"test": "pnpm exec vitest run",
		"visual:test": "node scripts/visual-runner.mjs",
		"visual:update": "node scripts/visual-runner.mjs --update",
		"visual:control": "node scripts/visual-runner.mjs --control",
		"visual:test-harness": "node --test scripts/visual-policy.test.mjs",
		"visual:typecheck": "tsc -p tsconfig.visual.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:health-strict": "tsc -p tsconfig.health-strict.json --noEmit"
	},
	"dependencies": {
		"@codemem/core": "workspace:^",
		"@preact/signals": "^2.11.1",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-toggle-group": "^1.1.19",
		"@radix-ui/react-tooltip": "^1.2.16",
		"dompurify": "^3.4.13",
		"lucide": "1.52.0",
		"marked": "^18.0.11",
		"preact": "^10.29.8",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@preact/preset-vite": "^2.10.6",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
