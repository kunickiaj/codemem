{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true
	},
	"include": [
		"playwright*.config.ts",
		"visual/**/*.ts",
		"scripts/visual-policy.mjs",
		"scripts/visual-runner.mjs"
	]
}
