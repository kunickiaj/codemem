							}
						]
					},
					"maxItems": 200,
					"description": "Memory IDs to expand"
				},
				"depth_before": {
					"type": "integer",
					"minimum": 0,
					"description": "Timeline items before",
					"default": 3
				},
				"depth_after": {
					"type": "integer",
					"minimum": 0,
					"description": "Timeline items after",
					"default": 3
