				},
				"limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 50,
					"description": "Max items to include"
				},
				"compact": {
					"type": "boolean",
					"description": "When true, render a scannable index of all items with full detail only for the top N (default 3). Saves tokens when broad overview matters more than per-item detail."
				},
				"compact_detail_count": {
					"type": "integer",
					"minimum": 0,
					"maximum": 50,
					"description": "Number of items to show in full detail in compact mode (default 3)"
				},
				"compression_mode": {
					"type": "string",
					"enum": ["off", "compact", "ids"],
					"description": "Near-related compression mode: off disables it, compact applies only to compact rendering, ids applies in all modes. Defaults to CODEMEM_PACK_COMPRESSION or compact."
				},
				"kind": {
					"type": "string",
					"description": "Filter by memory kind"
